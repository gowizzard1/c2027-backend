# Database
DATABASE_URL="postgresql://YOUR_USER:YOUR_PASSWORD@localhost:5432/campaign_db"

# Server
PORT=5001
NODE_ENV=development
LOG_LEVEL=debug

# Admin Credentials (CHANGE THESE — minimum 8 chars for password)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_me_to_a_strong_password

# JWT Secret (REQUIRED — generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
JWT_SECRET=CHANGE_ME_generate_a_64_char_hex_string_with_the_command_above

# CORS (comma-separated origins, optional — defaults to FRONTEND_URL)
# CORS_ORIGINS=http://localhost:3000,https://yourdomain.com

# M-Pesa (Daraja API — https://developer.safaricom.co.ke)
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_PASSKEY=
MPESA_SHORTCODE=174379
MPESA_CALLBACK_URL=https://yourdomain.com/api/mpesa/callback
MPESA_ENV=sandbox

# Flutterwave Card Payments (https://developer.flutterwave.com)
FLW_SECRET_KEY=
FLW_PUBLIC_KEY=
FLW_ENCRYPTION_KEY=

# Africa's Talking (SMS)
AT_API_KEY=
AT_USERNAME=
AT_SENDER_ID=CAMPAIGN

# WhatsApp Business API
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=

# Frontend URL
FRONTEND_URL=http://localhost:3000

# Object Storage for uploads (S3-compatible — Cloudflare R2 or AWS S3)
# If unset, uploads fall back to local disk (dev only — not durable in production).
# --- Cloudflare R2 example ---
# S3_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
# S3_REGION=auto
# S3_BUCKET=campaign-uploads
# S3_ACCESS_KEY_ID=<r2_access_key_id>
# S3_SECRET_ACCESS_KEY=<r2_secret_access_key>
# S3_PUBLIC_URL=https://pub-<hash>.r2.dev        # R2 public bucket URL or your CDN domain
# --- AWS S3 example (omit S3_ENDPOINT) ---
# S3_REGION=eu-west-1
# S3_BUCKET=campaign-uploads
# S3_ACCESS_KEY_ID=<aws_access_key_id>
# S3_SECRET_ACCESS_KEY=<aws_secret_access_key>
# S3_PUBLIC_URL=https://campaign-uploads.s3.eu-west-1.amazonaws.com

# Email (SMTP) for volunteer invites — e.g. Gmail with an App Password
# When unset, invite emails are logged to the console instead of sent (dev fallback).
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_USER=youremail@gmail.com
# SMTP_PASS=your_16_char_gmail_app_password
# SMTP_FROM="Campaign 2027 <youremail@gmail.com>"

# Resend transactional email API (recommended for Railway production; uses HTTPS/443)
# Create an API key at https://resend.com/api-keys and verify your sending domain.
# RESEND_API_KEY=re_xxxxxxxxx
# RESEND_FROM="Maiywa 4 Turbo 2027 <volunteers@maiywa.site>"
