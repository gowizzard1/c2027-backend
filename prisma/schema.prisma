generator client {
  provider      = "prisma-client-js"
  // native = local dev machine; the musl target is for the Alpine production image.
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Donation {
  id                 String   @id @default(cuid())
  amount             Float
  name               String
  email              String
  phone              String
  paymentMethod      String
  status             String   @default("pending")
  mpesaRequestId     String?  @unique
  mpesaReceiptNumber String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @default(now()) @updatedAt

  @@index([status, createdAt])
  @@index([phone])
  @@index([email])
}

model Volunteer {
  id           String   @id @default(cuid())
  name         String
  email        String
  phone        String
  idNumber     String
  county       String
  constituency String
  ward         String
  role         String
  experience   String?
  status       String   @default("pending")
  // Unguessable per-volunteer token for the account activation (set-password) link.
  accessToken  String?  @unique
  // bcrypt hash, set when the volunteer activates their account via the invite link.
  passwordHash String?
  // Account and invite activity visible to administrators (never includes the password hash).
  inviteDeliveryStatus String   @default("not_sent") // not_sent | sent | failed
  inviteSentAt         DateTime?
  inviteFailedAt       DateTime?
  activatedAt          DateTime?
  lastLoginAt          DateTime?
  lastLoginFailedAt    DateTime?
  loginFailureCount    Int      @default(0)
  // Recorded when admin first approves the volunteer; used for initial stipend eligibility.
  approvedAt           DateTime?
  // Reversible admin archive: preserve the prior status so restore is accurate.
  archivedAt           DateTime?
  statusBeforeArchive  String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @default(now()) @updatedAt

  @@index([status])
  @@index([county])
  @@index([role])
}

model Order {
  id              String   @id @default(cuid())
  itemsJson       String
  total           Float
  name            String
  phone           String
  deliveryAddress String?
  status          String   @default("pending")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @default(now()) @updatedAt

  @@index([status, createdAt])
  @@index([phone])
}

model NewsItem {
  id        String   @id @default(cuid())
  title     String
  content   String?
  date      String
  category  String   @default("General")
  type      String
  image     String?
  emoji     String?
  time      String?
  location  String?
  createdAt DateTime @default(now())

  @@index([type, createdAt])
  @@index([category])
}

model Product {
  id        String   @id @default(cuid())
  name      String
  price     Float
  image     String   @default("📦")
  category  String   @default("General")
  sizesJson String?
  inStock   Boolean  @default(true)
  createdAt DateTime @default(now())

  @@index([category, inStock])
}

model Setting {
  key   String @id
  value String
}

model ManifestoItem {
  id          String   @id @default(cuid())
  pillar      String
  title       String
  description String
  details     String?
  icon        String   @default("📌")
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())

  @@index([pillar])
}

model Biography {
  id        String   @id @default(cuid())
  section   String   @unique
  content   String
  updatedAt DateTime @updatedAt
}

// Interest captured while online payments are still being set up ("under integration").
// These are people who signalled willingness to donate and want to be contacted once ready.
model Pledge {
  id        String   @id @default(cuid())
  name      String
  email     String
  phone     String
  amount    Float?
  message   String?
  status    String   @default("new") // new | contacted | converted | archived
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@index([status, createdAt])
  @@index([phone])
  @@index([email])
}



// Privacy-conscious first-party site analytics. No IP address or raw user-agent is stored.
model AnalyticsEvent {
  id             String   @id @default(cuid())
  visitorId      String   // Anonymous UUID generated and retained in browser localStorage
  path           String
  referrerDomain String?  // Domain only, never full referrer URL/query parameters
  deviceType     String   // mobile | tablet | desktop | unknown
  createdAt      DateTime @default(now())

  @@index([createdAt])
  @@index([path, createdAt])
  @@index([visitorId, createdAt])
}

// Mobile-data stipend requests. Approval/payment is manual today; fields support future M-Pesa automation.
model StipendRequest {
  id          String   @id @default(cuid())
  volunteerId String   // Legacy owner ID retained during migration window
  accountId   String?
  account     VolunteerAccount? @relation(fields: [accountId], references: [id], onDelete: Restrict)
  status      String   @default("pending") // pending | approved | paid | rejected
  requestedAt DateTime @default(now())
  approvedAt  DateTime?
  paidAt      DateTime?
  rejectedAt  DateTime?
  adminNote   String?
  paymentRef  String?  // Reserved for future M-Pesa transaction reference

  @@index([volunteerId, requestedAt])
  @@index([accountId, requestedAt])
  @@index([status, requestedAt])
}

// Aggregate mobilizer activity report. Intentionally excludes named voter/contact lists and preference data.
model MobilizerReport {
  id            String   @id @default(cuid())
  volunteerId   String   // Legacy owner ID retained during migration window
  assignmentId  String?
  assignment    VolunteerRoleAssignment? @relation(fields: [assignmentId], references: [id], onDelete: Restrict)
  periodStart   DateTime // UTC Monday marking the reporting week
  peopleReached Int      @default(0)
  meetingsHeld  Int      @default(0)
  newVolunteers Int      @default(0)
  keyIssues     String?
  notes         String?
  status        String   @default("submitted") // submitted | reviewed | actioned
  adminNote     String?
  reviewedAt    DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([volunteerId, periodStart])
  @@unique([assignmentId, periodStart])
  @@index([assignmentId, periodStart])
  @@index([status, createdAt])
  @@index([periodStart])
}

// Multi-role volunteer identity. One account per normalized email, one assignment per role.
// Legacy Volunteer rows remain temporarily for migration/audit compatibility.
model VolunteerAccount {
  id                   String   @id
  email                String
  emailNormalized      String   @unique
  name                 String
  phone                String
  idNumber             String
  passwordHash         String?
  accessToken          String?  @unique
  inviteDeliveryStatus String   @default("not_sent")
  inviteSentAt         DateTime?
  inviteFailedAt       DateTime?
  activatedAt          DateTime?
  lastLoginAt          DateTime?
  lastLoginFailedAt    DateTime?
  loginFailureCount    Int      @default(0)
  sessionVersion       Int      @default(0)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  assignments          VolunteerRoleAssignment[]
  stipendRequests      StipendRequest[]

  @@index([email])
}

// A person can hold multiple roles, but never the same role twice.
model VolunteerRoleAssignment {
  id                  String   @id
  accountId           String
  account             VolunteerAccount @relation(fields: [accountId], references: [id], onDelete: Restrict)
  role                String
  experience          String?
  county              String
  constituency        String
  ward                String
  pollingStationId    String?
  pollingStation      PollingStation? @relation(fields: [pollingStationId], references: [id], onDelete: Restrict)
  status              String   @default("pending")
  approvedAt          DateTime?
  archivedAt          DateTime?
  statusBeforeArchive String?
  sourceVolunteerId   String?  @unique // legacy Volunteer row used to seed this assignment
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  mobilizerReports    MobilizerReport[]
  pollingResults      PollingResultReport[]

  @@unique([accountId, role])
  @@index([status])
  @@index([role])
  @@index([county])
  @@index([pollingStationId])
}

// Admin-managed official polling station registry for Turbo Constituency, Uasin Gishu.
model PollingStation {
  id           String   @id @default(cuid())
  name         String
  ward         String
  county       String   @default("Uasin Gishu")
  constituency String   @default("Turbo")
  active       Boolean  @default(true)
  approvalStatus String @default("approved") // pending | approved | rejected
  proposedByEmail String?
  proposedAt   DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  assignments  VolunteerRoleAssignment[]
  resultReports PollingResultReport[]

  @@unique([name, ward])
  @@index([active, ward])
}

// Admin-managed candidate registry for an election reporting period.
model ElectionCandidate {
  id        String   @id @default(cuid())
  name      String
  party     String?
  imageUrl  String?
  active    Boolean  @default(true)
  archivedAt DateTime?
  activeBeforeArchive Boolean?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([name, party])
  @@index([active, name])
}

// Private polling-station result reported by an assigned polling agent.
// This is an internal agent report, not an official public declaration.
model PollingResultReport {
  id                 String   @id @default(cuid())
  assignmentId       String
  assignment         VolunteerRoleAssignment @relation(fields: [assignmentId], references: [id], onDelete: Restrict)
  pollingStationId   String
  pollingStation     PollingStation @relation(fields: [pollingStationId], references: [id], onDelete: Restrict)
  revisionNumber     Int      @default(1)
  status             String   @default("submitted") // submitted | under_review | verified | disputed | superseded
  candidateVotesJson String
  validVotes         Int
  rejectedVotes      Int      @default(0)
  notes              String?
  reviewNote         String?
  archivedAt         DateTime?
  archiveNote        String?
  archivedBy         String?
  submittedAt        DateTime @default(now())
  reviewedAt         DateTime?
  attachments        PollingResultAttachment[]

  @@unique([assignmentId, revisionNumber])
  @@index([pollingStationId, submittedAt])
  @@index([status, submittedAt])
}

// Private object-storage evidence attachment. Object key is never returned publicly.
model PollingResultAttachment {
  id           String   @id @default(cuid())
  reportId     String
  report       PollingResultReport @relation(fields: [reportId], references: [id], onDelete: Restrict)
  objectKey    String   @unique
  mimeType     String
  originalName String
  createdAt    DateTime @default(now())

  @@index([reportId])
}

// Admin-published mobile application releases. Android APK files are public campaign app downloads.
model MobileAppRelease {
  id           String   @id @default(cuid())
  platform     String   @default("android") // android | ios
  version      String
  buildNumber  String?
  fileUrl      String?
  externalUrl  String?
  releaseNotes String?
  active       Boolean  @default(false)
  archivedAt   DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([platform, active])
  @@index([archivedAt])
}
